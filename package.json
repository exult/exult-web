{
  "name": "exult-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build-site.mjs",
    "test": "node --test tools/tests/*.test.mjs",
    "validate:html": "vnu --errors-only --skip-non-html dist && vnu --errors-only --html dist/seventowers/404.shtml",
    "check:a11y": "node tools/audit-accessibility.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "markdown-it": "15.0.3",
    "playwright": "1.64.1",
    "shiki": "4.5.0",
    "vnu-jar": "26.10.12"
  }
}
